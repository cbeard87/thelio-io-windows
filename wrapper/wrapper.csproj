<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Company>System76</Company>
    <Product>Thelio Io Wrapper</Product>
    <Copyright>GPL-3.0</Copyright>
    <AssemblyTitle>System76 Thelio Io Wrapper</AssemblyTitle>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>..\app.manifest</ApplicationManifest>
    <!-- Publish as one self-contained .exe so end users need no .NET runtime. -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.4" />
  </ItemGroup>
</Project>
